# Copy this into Streamlit Cloud → app → Settings → Secrets (or to a local
# .streamlit/secrets.toml, which is gitignored) to make keeper submissions
# durable via Google Sheets. Without it, the app falls back to local files.

# The ID from your Google Sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
sheet_id = "your-google-sheet-id-here"

# Paste the JSON key from your Google Cloud service account, field by field.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "kreeper-bot@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
